# Sandbox image for the browser verification stage (verify.py).
# Build:  docker build -f Dockerfile.sandbox -t finanalyst-sandbox .
# Check that this tag exists on mcr.microsoft.com/playwright/python and that it matches the Playwright version you use.
FROM mcr.microsoft.com/playwright/python:v1.49.0-noble
RUN pip install --no-cache-dir trafilatura httpx
WORKDIR /app
